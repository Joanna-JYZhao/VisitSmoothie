  "cards": [
    {
      "dot": "emerald",
      "title": "主目标：减少陌生医生的信息准备成本",
      "items": [
        "一页速读：主诉、关键变化、用药过敏、既往检查、待核实问题。",
        "检查候选仅由审定路径匹配；信息不足时只列待核实项，医生作最终决定。"
      ]
    },
    {
      "dot": "cyan",
      "title": "追问算法：受控检索＋优先级排序",
      "items": [
        "先筛选适用诊断、来源版本与未回答问题；保留一个开放症状入口。",
        "按审定优先级、信息缺口、变化、相关性排序，再扣除重复与回答负担。",
        "每次一问；常规最多三问；可选没有、不确定、暂不回答。风险提示独立处理。"
      ]
    },
    {
      "dot": "amber",
      "title": "趋势算法：描述记录变化",
      "items": [
        "按症状和时间对齐；标记用药与就诊事件；近7天与前7天中位数比较。",
        "每窗至少4个有效日才描述方向；此为待验证的工程默认，不是医学阈值。",
        "缺失、否定、未询问分开；展示覆盖率；时间相邻不等于因果。"
      ]
    },
    {
      "dot": "rose",
      "title": "关联追问示例与边界",
      "items": [
        "若报告为冠心病／心绞痛相关背景，审定题库可包含牙或下颌不适、发生情境等。",
        "牙痛不等于心脏病；不能将所有心脏诊断套入相同问题。依据 AHA 胸痛指南及 NHS 患者教育。",
        "本图是新方案设计，未接入现有网站，算法和临床规则仍需评测。"
      ]
    }
  ]
