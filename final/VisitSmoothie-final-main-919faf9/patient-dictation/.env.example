# Only the CLI reads these variables. Library callers inject configuration.
# Use an audio-transcription provider key, separate from your analysis API key.
DICTATION_API_KEY=
DICTATION_BASE_URL=https://api.openai.com/v1
DICTATION_MODEL=gpt-transcribe
DICTATION_TIMEOUT_MS=120000
DICTATION_MAX_AUDIO_BYTES=25000000
# Optional: language (legacy/compatible APIs) or languages (gpt-transcribe).
# DICTATION_LANGUAGE_FIELD=languages
