# Anthropic 的 API Key。留空时用内置规则引擎回答，拍照不可用。
ANTHROPIC_API_KEY=
# 对话、整理和识别照片用的模型
CLAUDE_MODEL=claude-opus-5-5

# 智谱 GLM 的 API Key，只用于语音转文字。留空时语音不可用。
GLM_API_KEY=
# 语音转文字用的模型
GLM_ASR_MODEL=glm-asr-2512

# 语音接口地址。Z.ai 国际版改为 https://api.z.ai/api/paas/v4
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 患者数据加密主密钥：64 位十六进制（32 字节）。留空时首次运行自动生成并写入 .env.local
DATA_ENCRYPTION_KEY=
